<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Storyboard.Foundation</RootNamespace>
    <AssemblyName>Storyboard.Foundation</AssemblyName>
    <Version>0.1.2</Version>
    <PackageId>Storyboard.Foundation</PackageId>
    <Authors>Storyboard</Authors>
    <Description>Dependency-neutral shared utilities for Storyboard products.</Description>
    <PackageTags>storyboard;paths;portability</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
